{
  "name": "verify-web-vitals",
  "version": "0.1.0",
  "description": "Measure Core Web Vitals on the journey you use for functional checks, and record one Playwright video per viewport that proves both.",
  "license": "MIT",
  "author": "SereneMatt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SereneMatt/verify-web-vitals.git"
  },
  "type": "module",
  "bin": {
    "verify-web-vitals": "scripts/record.mjs",
    "verify-web-vitals-frame": "scripts/frame.mjs"
  },
  "files": [
    "scripts",
    "SKILL.md",
    "GLOSSARY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "playwright": "1.65.1",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "oxfmt": "0.78.0"
  },
  "packageManager": "bun@1.4.5"
}
